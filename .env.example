# Copy to .env in the repository root. Every variable is optional.
# The server reads .env at startup; variables already set in the environment win.

# --- Data mode ---------------------------------------------------------------
# "real" (default) uses OpenF1 and Jolpica. "demo" serves a clearly labelled
# SIMULATED session with fictional drivers, for trying the UI offline.
DATA_MODE=real

# --- OpenF1 (timing, positions, telemetry, race control) ---------------------
# Without credentials the app uses the free tier: every session from 2023 is
# available as HISTORICAL, but nothing is shown live while a session runs.
# A paid OpenF1 Sponsor account (https://openf1.org) unlocks live data over MQTT.
# These stay on the server and are never sent to the browser.
OPENF1_USERNAME=
OPENF1_PASSWORD=

# Override only if OpenF1 moves its endpoints.
# OPENF1_BASE_URL=https://api.openf1.org/v1
# OPENF1_TOKEN_URL=https://api.openf1.org/token
# OPENF1_MQTT_URL=wss://mqtt.openf1.org:8084/mqtt

# --- Jolpica (calendar, results, standings, archive since 1950) --------------
# No key needed. Jolpica asks clients to identify themselves.
# JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
JOLPICA_USER_AGENT=f1-control-room/0.1 (personal, non-commercial; you@example.com)

# --- Server ------------------------------------------------------------------
PORT=8787
# Use 0.0.0.0 to reach the app from other devices on your network.
HOST=127.0.0.1
# Response cache (memory + disk). Relative paths resolve from the repo root.
CACHE_DIR=.cache
# Built web app served by the API server in production. Defaults to web/dist.
# WEB_DIST=
# Allowed browser origin for the API. Defaults to any origin.
# CORS_ORIGIN=http://localhost:5173
# fatal | error | warn | info | debug | silent
LOG_LEVEL=info
